{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/report?type=weekly",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/report?type=monthly",
      "schedule": "0 4 1 * *"
    }
  ]
}
